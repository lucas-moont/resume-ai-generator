# Copy to .env and fill as needed (never commit .env)

# Optional: higher GitHub API rate limits and access to private repos listing.
# Least privilege: a read-only token is enough (fine-grained PAT with only "Contents: Read", or a
# classic token with just the `public_repo` scope). Do not grant write scopes.
GITHUB_TOKEN=

# AI provider routing:
# - auto (default): Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set,
#   otherwise Ollama. NOTE: a local `ant auth login` sets no key, so to use Claude via your
#   machine's login set AI_PROVIDER=claude explicitly (or just pick a claude-* model in the UI).
# - claude: force Claude (authenticated via `ant auth login` or ANTHROPIC_API_KEY)
# - gemini: force Gemini
# - ollama: force Ollama
# Picking a claude-* or gemini-* model in the UI selector routes to that backend regardless of
# this setting; only unknown/Ollama model names fall back to AI_PROVIDER.
AI_PROVIDER=claude

# Optional global model override passed to the active provider.
# AI_DEFAULT_MODEL=

# --- Anthropic / Claude -------------------------------------------------------------------------
# "Linked on your machine": run `ant auth login` once (installs with the Claude CLI / `ant` CLI)
# and the app uses that local session automatically — no key needed here. This is the MORE SECURE
# option: the token is short-lived, refreshable and revocable, and never stored in this repo.
# If you use a static key instead, prefer a workspace-scoped / least-privilege key and never
# commit it (.env is gitignored). Get one at https://console.anthropic.com/settings/keys :
# ANTHROPIC_API_KEY=
# Default Claude model (also selectable per-generation in the UI). Options: claude-sonnet-5
# (balanced, default), claude-opus-4-8 (best quality), claude-haiku-4-5 (fastest/cheapest).
# CLAUDE_MODEL=claude-sonnet-5
# Max output tokens for the resume JSON (raise if you enable thinking or hit truncation).
# CLAUDE_MAX_OUTPUT_TOKENS=8192
# Extended thinking: "off" (default, full budget for JSON) or "adaptive" (Claude reasons first).
# CLAUDE_THINKING=off

# Ollama HTTP API (default is fine for local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match a name from `ollama list` (e.g. llama3.2, llama3.1:8b). If you see "model not found",
# run `ollama pull <name>` first. Stronger local models give noticeably better resumes than the
# small llama3.2 — e.g. `ollama pull gemma4` / `ollama pull glm-5.2`, then set the exact tag here.
OLLAMA_MODEL=llama3.2
# Context window: the default (2k-4k on many models) can silently truncate the profile + PDF +
# projects prompt and lower quality. 8192 fits most resumes; raise if you have a large profile.
# OLLAMA_NUM_CTX=8192
# Max tokens Ollama may generate for the resume JSON.
# OLLAMA_NUM_PREDICT=4096

# Optional: Google Gemini (AI Studio API key).
# GEMINI_API_KEY=
# Model for generateContent (default gemini-2.5-flash). See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-2.5-flash
# Max output tokens for the resume JSON (avoids truncated/invalid JSON on longer resumes).
# GEMINI_MAX_OUTPUT_TOKENS=8192

# How long the UI stream waits for each LLM call (local 8B–14B models often need 5–10+ minutes).
# LLM_TIMEOUT_SECONDS=900

# Generation temperature shared by both providers (0.0 = deterministic, higher = more varied).
# LLM_TEMPERATURE=0.4

# Override data directory (default: repo-root/data)
# DATA_DIR=

# Override profile JSON path (default: data/profile/resume.json, then Profile.json, then data/profile_master.json)
# PROFILE_JSON_PATH=

# Optional: profile PDF for text extraction (default: data/profile/Profile.pdf, profile.pdf, or resume.pdf)
# PROFILE_PDF_PATH=

# Max characters of extracted PDF text sent to the LLM (default 32000)
# PROFILE_PDF_MAX_CHARS=
