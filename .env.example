# Copy to .env and fill as needed (never commit .env)

# Optional: higher GitHub API rate limits and access to private repos listing
GITHUB_TOKEN=

# Ollama HTTP API (default is fine for local)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Must match a name from `ollama list` (e.g. llama3.2, llama3.2:latest). If you see "model not found", run `ollama pull <name>`.
OLLAMA_MODEL=llama3.2

# Optional: Google Gemini (AI Studio API key). When GEMINI_API_KEY is set, generate/refine/PDF extraction use Gemini instead of Ollama.
# GEMINI_API_KEY=
# Model for generateContent (default gemini-2.5-flash). See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-2.5-flash

# Override data directory (default: repo-root/data)
# DATA_DIR=

# Override profile JSON path (default: data/profile/resume.json, then Profile.json, then data/profile_master.json)
# PROFILE_JSON_PATH=

# Optional: profile PDF for text extraction (default: data/profile/Profile.pdf, profile.pdf, or resume.pdf)
# PROFILE_PDF_PATH=

# Max characters of extracted PDF text sent to the LLM (default 32000)
# PROFILE_PDF_MAX_CHARS=
